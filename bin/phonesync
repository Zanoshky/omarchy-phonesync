#!/usr/bin/env python3
"""phonesync: Omarchy themes in step with Hyprtile and Phosphor, over their link.

Pair a phone once, then:

  * when you pick a theme in Omarchy, the phone gets its exact colours;
  * when you pick a theme on the phone, Omarchy switches to it: to its own
    theme of the same name when it has one, else to a theme written from the
    phone's colours into ~/.config/omarchy/themes/<app>-<name>.

The computer always connects out to the phone and holds the line open, so
nothing needs installing and no port needs opening here. Phones are found
over mDNS (avahi-browse, which Omarchy ships), or by the address the phone's
link menu shows. Only the Python standard library is used.

  phonesync watch             JSON lines for the bar widget, and the sync itself;
                              takes commands on stdin: scan, pair HOST PORT,
                              answer yes|no, forget ID, push
  phonesync pair HOST [PORT]  pair from a terminal (47800 Hyprtile, 47801 Phosphor)
  phonesync peers             paired phones, as JSON

The protocol is Link.kt in the launchers; tools/zanolink.py there speaks it
too, and shares this identity and peer list in ~/.config/zanolink.
"""
import colorsys
import hashlib
import hmac
import json
import os
import queue
import re
import secrets
import shutil
import socket
import struct
import subprocess
import sys
import threading
import time
import zlib

HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config/zanolink")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local/state")), "phonesync")
OMARCHY_STATE = os.path.join(HOME, ".local/state/omarchy/current")
USER_THEMES = os.path.join(HOME, ".config/omarchy/themes")
OMARCHY_PATH = os.environ.get("OMARCHY_PATH", os.path.join(HOME, ".local/share/omarchy"))
SERVICE = "_zanolink._tcp"
PORTS = {"hyprtile": 47800, "phosphor": 47801}
PAIR_TIMEOUT = 90
# Phone theme names whose Omarchy twin has another name, and back.
TO_OMARCHY = {"catppuccin-mocha": "catppuccin"}
FROM_OMARCHY = {v: k for k, v in TO_OMARCHY.items()}
APPS = ("hyprtile", "phosphor")


# Link: keys, pairing, signed messages. Keep in step with Link.kt.

P = 2**255 - 19
A24 = 121665


def x25519(k, u):
    """RFC 7748."""
    k = bytearray(k)
    k[0] &= 248
    k[31] = (k[31] & 127) | 64
    kn = int.from_bytes(k, "little")
    uu = bytearray(u)
    uu[31] &= 127
    x1 = int.from_bytes(uu, "little") % P
    x2, z2, x3, z3, swap = 1, 0, x1, 1, 0
    for t in range(254, -1, -1):
        bit = (kn >> t) & 1
        if swap ^ bit:
            x2, x3, z2, z3 = x3, x2, z3, z2
        swap = bit
        a = x2 + z2; aa = a * a % P
        b = x2 - z2; bb = b * b % P
        e = aa - bb
        c = x3 + z3; d = x3 - z3
        da = d * a % P; cb = c * b % P
        x3 = (da + cb) ** 2 % P
        z3 = x1 * (da - cb) ** 2 % P
        x2 = aa * bb % P
        z2 = e * (aa + A24 * e) % P
    if swap:
        x2, z2 = x3, z3
    return (x2 * pow(z2, P - 2, P) % P).to_bytes(32, "little")


def sha(b):
    return hashlib.sha256(b).digest()


def load(name, default):
    try:
        with open(os.path.join(CONF, name)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save(name, data):
    os.makedirs(CONF, mode=0o700, exist_ok=True)
    path = os.path.join(CONF, name)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def identity():
    me = load("key.json", None)
    if not me:
        me = {"priv": secrets.token_bytes(32).hex(), "name": socket.gethostname().split(".")[0][:40] or "computer"}
        save("key.json", me)
    priv = bytes.fromhex(me["priv"])
    pub = x25519(priv, bytes([9] + [0] * 31))
    return priv, pub, sha(pub).hex()[:12], me["name"]


class Line:
    def __init__(self, host, port, timeout=PAIR_TIMEOUT + 5):
        self.s = socket.create_connection((host, port), timeout=5)
        self.s.settimeout(timeout)
        self.f = self.s.makefile("rwb")
        self.lock = threading.Lock()

    def send(self, o):
        with self.lock:
            self.f.write((json.dumps(o) + "\n").encode())
            self.f.flush()

    def recv(self):
        line = self.f.readline(1 << 20)
        if not line:
            raise ConnectionError("the phone closed the line")
        return json.loads(line)

    def close(self):
        for c in (self.f, self.s):
            try:
                c.close()
            except OSError:
                pass


def signed(key, kind, my_id, body=""):
    ts = int(time.time() * 1000)
    mac = hmac.new(key, f"{kind}.{ts}.{body}".encode(), hashlib.sha256).hexdigest()
    return {"t": kind, "id": my_id, "ts": ts, "body": body, "mac": mac}


def verified(key, m):
    mac = hmac.new(key, f"{m.get('t')}.{m.get('ts')}.{m.get('body')}".encode(), hashlib.sha256).hexdigest()
    return hmac.compare_digest(mac, str(m.get("mac", "")))


def pair(host, port, ask):
    """Pairs with the phone at host:port. [ask](name, app, code) says whether the user saw the same code."""
    priv, pub, my_id, name = identity()
    ln = Line(host, port)
    try:
        nonce = secrets.token_bytes(16)
        ln.send({"t": "hello", "v": 1, "app": "omarchy", "name": name, "id": my_id, "port": 0, "commit": sha(pub + nonce).hex()})
        h = ln.recv()
        their = bytes.fromhex(h.get("pub", ""))
        their_nonce = bytes.fromhex(h.get("nonce", ""))
        if len(their) != 32 or len(their_nonce) != 16:
            raise ValueError("the phone sent a bad hello")
        ln.send({"t": "reveal", "pub": pub.hex(), "nonce": nonce.hex()})
        shared = x25519(priv, their)
        if not any(shared):
            raise ValueError("bad key")
        lo, hi = sorted([pub, their], key=lambda b: b.hex())
        code = "%06d" % (int.from_bytes(sha(b"zanolink-code" + shared + lo + hi + nonce + their_nonce)[:4], "big") % 1_000_000)
        pname, papp = str(h.get("name") or "phone")[:40], str(h.get("app") or "")
        yes = bool(ask(pname, papp, code))
        ln.send({"t": "ok" if yes else "no"})
        theirs = ln.recv().get("t") == "ok"
        if not (yes and theirs):
            return None
        pid = sha(their).hex()[:12]
        peers = load("peers.json", {})
        peers[pid] = {"name": pname, "app": papp, "addr": f"{host}:{port}", "key": sha(b"zanolink-key" + shared).hex()}
        save("peers.json", peers)
        return pid
    finally:
        ln.close()


def scan(seconds=3):
    """Launchers with link on, found over mDNS: {id: {name, app, host, port}}."""
    if not shutil.which("avahi-browse"):
        return {}
    try:
        out = subprocess.run(["avahi-browse", "-rptk", SERVICE], capture_output=True, text=True, timeout=seconds + 5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    found = {}
    for line in out.splitlines():
        f = line.split(";")
        if len(f) < 10 or f[0] != "=" or f[2] != "IPv4":
            continue
        txt = dict(re.findall(r'"([a-z]+)=([^"]*)"', f[9]))
        if txt.get("id"):
            found[txt["id"]] = {"id": txt["id"], "name": txt.get("name") or f[3], "app": txt.get("app", ""), "host": f[7], "port": int(f[8])}
    return found




# Omarchy themes

def current_theme():
    try:
        with open(os.path.join(OMARCHY_STATE, "theme.name")) as f:
            return f.read().strip()
    except OSError:
        return ""


def theme_changed_ms():
    try:
        return int(os.path.getmtime(os.path.join(OMARCHY_STATE, "theme.name")) * 1000)
    except OSError:
        return 0


def theme_dir(name):
    for base in (USER_THEMES, os.path.join(OMARCHY_PATH, "themes")):
        p = os.path.join(base, name)
        if os.path.isdir(p):
            return p
    return None


def read_colors(path):
    """colors.toml as a dict of strings. Flat key = "value" lines are all Omarchy uses."""
    out = {}
    try:
        with open(path) as f:
            for line in f:
                m = re.match(r'^\s*([A-Za-z0-9_]+)\s*=\s*"([^"]*)"', line)
                if m:
                    out[m.group(1)] = m.group(2)
    except OSError:
        pass
    return out


def gradient_colors(spec):
    out = []
    for m in re.finditer(r"rgba?\(\s*([0-9a-fA-F]{6})(?:[0-9a-fA-F]{2})?\s*\)|#([0-9a-fA-F]{6})\b", spec or ""):
        out.append("#" + (m.group(1) or m.group(2)).lower())
    return out


def omarchy_theme():
    """What we tell the phone about the current Omarchy theme."""
    name = current_theme()
    colors = read_colors(os.path.join(OMARCHY_STATE, "theme/colors.toml"))
    if not name or "background" not in colors:
        return None
    t = {
        "app": "omarchy", "theme": FROM_OMARCHY.get(name, name), "light": colors.get("mode") == "light",
        "bg": colors.get("background"), "fg": colors.get("foreground"), "accent": colors.get("accent") or colors.get("blue"),
        "colors": gradient_colors(colors.get("hyprland_active_border", "")) or [colors.get("accent", colors.get("foreground"))],
        "palette": colors, "changed": theme_changed_ms(),
    }
    # A theme we wrote from a phone says where it came from, so that phone can use its own.
    try:
        with open(os.path.join(theme_dir(name) or "", "phonesync.json")) as f:
            t["origin"] = json.load(f)
    except (OSError, ValueError):
        pass
    return t


def hx(c):
    c = (c or "").lstrip("#")[-6:]
    try:
        return tuple(int(c[i:i + 2], 16) for i in (0, 2, 4))
    except ValueError:
        return (0, 0, 0)


def to_hex(rgb):
    return "#%02x%02x%02x" % tuple(max(0, min(255, int(round(v)))) for v in rgb)


def mix(a, b, t):
    a, b = hx(a), hx(b)
    return to_hex(tuple(x * (1 - t) + y * t for x, y in zip(a, b)))


def hue(base, deg):
    """[base]'s lightness and saturation at another hue: terminal colours for a one hue phosphor theme."""
    r, g, b = (v / 255 for v in hx(base))
    h, l, s = colorsys.rgb_to_hls(r, g, b)
    s = max(s, 0.55)
    l = min(max(l, 0.45), 0.7)
    return to_hex(tuple(v * 255 for v in colorsys.hls_to_rgb(deg / 360, l, s)))


def colors_from_phone(t):
    """A full Omarchy colors.toml from a launcher's theme."""
    bg, fg, accent = t.get("bg", "#000000"), t.get("fg", "#ffffff"), t.get("accent", "#0068ff")
    light = bool(t.get("light"))
    dim = t.get("dim") or mix(fg, bg, 0.45)
    ansi = t.get("ansi") or []
    if len(ansi) >= 16:
        red, green, yellow, blue, magenta, cyan = ansi[1:7]
        bred, bgreen, byellow, bblue, bmagenta, bcyan = ansi[9:15]
        bright_fg = ansi[15]
    else:
        red = t.get("warn") or t.get("urgent") or hue(accent, 0)
        yellow, green, cyan, blue, magenta = (t.get("sun") or hue(accent, 45)), hue(accent, 125), hue(accent, 185), hue(accent, 220), hue(accent, 300)
        to = "#000000" if light else "#ffffff"
        bred, bgreen, byellow, bblue, bmagenta, bcyan = (mix(c, to, 0.25) for c in (red, green, yellow, blue, magenta, cyan))
        bright_fg = t.get("bright") or mix(fg, to, 0.3)
    shade = "#ffffff" if light else "#000000"
    surface = t.get("surface") if t.get("surface") and t.get("surface") != bg else mix(bg, fg, 0.07)
    border = t.get("colors") or [accent]
    c = {
        "mode": "light" if light else "dark",
        "accent": accent, "selection": mix(bg, accent, 0.28), "muted": t.get("inactive") or t.get("faint") or mix(dim, bg, 0.35),
        "background": bg, "dark_background": mix(bg, shade, 0.2), "darker_background": mix(bg, shade, 0.4), "lighter_background": surface,
        "foreground": fg, "dark_foreground": dim, "light_foreground": mix(fg, bright_fg, 0.5), "bright_foreground": bright_fg,
        "red": red, "yellow": yellow, "orange": mix(red, yellow, 0.5), "green": green, "cyan": cyan, "blue": blue, "magenta": magenta,
        "brown": mix(red, "#000000", 0.5),
        "bright_red": bred, "bright_yellow": byellow, "bright_green": bgreen, "bright_cyan": bcyan, "bright_blue": bblue, "bright_magenta": bmagenta,
        "hyprland_active_border": " ".join("rgba(%see)" % c.lstrip("#")[-6:] for c in border) + (" 45deg" if len(border) > 1 else ""),
    }
    return c


def write_png(path, w, h, pixel):
    rows = bytearray()
    for y in range(h):
        rows.append(0)
        for x in range(w):
            rows.extend(pixel(x, y))
    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)
    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)) + chunk(b"IDAT", zlib.compress(bytes(rows), 9)) + chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)


def background(path, c, wall):
    """A quiet backdrop in the theme's colours: a diagonal fade with a soft glow of the accent.
    Drawn at 4K so it stays sharp on big screens, with a little dither so the fade does not band."""
    w, h = 3840, 2160
    a, b = hx(wall[0] if wall else c["darker_background"]), hx(wall[1] if len(wall) > 1 else c["background"])
    g = hx(c["accent"])
    noise = [((i * 2654435761) >> 7) % 100 / 100 for i in range(4096)]
    def pixel(x, y):
        t = (x / w + y / h) / 2
        dx, dy = (x - w * 0.72) / w, (y - h * 0.3) / h
        glow = max(0.0, 1 - (dx * dx + dy * dy) * 6) ** 2 * 0.35
        n = noise[(x * 31 + y * 17) & 4095]
        return bytes(int((a[i] * (1 - t) + b[i] * t) * (1 - glow) + g[i] * glow + n) for i in range(3))
    write_png(path, w, h, pixel)


def theme_for_phone(t):
    """The Omarchy theme name for a phone theme, writing one from its colours when needed."""
    name = (t.get("theme") or "").lower()
    app = t.get("app") if t.get("app") in APPS else "phone"
    origin = t.get("origin") or {}
    # A theme that came from Omarchy and went back to the phone keeps its name.
    if t.get("app") == "omarchy" or origin.get("app") == "omarchy":
        return None
    # A theme the phone got from Omarchy ("omarchy-nord") goes back to that theme.
    if name.startswith("omarchy-"):
        name = name[len("omarchy-"):]
    twin = TO_OMARCHY.get(name, name)
    if twin and theme_dir(twin) and not os.path.exists(os.path.join(theme_dir(twin), "phonesync.json")):
        return twin
    slug = re.sub(r"[^a-z0-9-]", "-", f"{app}-{name or 'theme'}")[:40]
    d = os.path.join(USER_THEMES, slug)
    os.makedirs(os.path.join(d, "backgrounds"), exist_ok=True)
    c = colors_from_phone(t)
    text = f"# Written by phonesync from {app} theme {name}. It is rewritten when that theme changes on the phone.\n"
    text += "".join(f'{k} = "{v}"\n' for k, v in c.items())
    try:
        with open(os.path.join(d, "colors.toml")) as f:
            same = f.read() == text
    except OSError:
        same = False
    bg = os.path.join(d, "backgrounds", "1-phonesync.png")
    if same and os.path.exists(bg):
        return slug
    with open(os.path.join(d, "colors.toml"), "w") as f:
        f.write(text)
    with open(os.path.join(d, "phonesync.json"), "w") as f:
        json.dump({"app": app, "theme": name}, f)
    if c.get("mode") == "light":
        open(os.path.join(d, "light.mode"), "w").close()
    elif os.path.exists(os.path.join(d, "light.mode")):
        os.remove(os.path.join(d, "light.mode"))
    background(bg, c, t.get("wall") or [])
    return slug


# The daemon

class Daemon:
    """Holds a line open to every paired phone, syncs both ways, and reports to the bar widget.

    Which side wins: each theme carries "changed", when a person last picked
    it. A phone theme is taken when it is newer than the Omarchy one; else the
    phone is sent the Omarchy theme. "echo" marks a phone theme that came from
    a computer, so it never counts as the phone's own pick.
    """

    def __init__(self, out=sys.stdout):
        self.out = out
        self.lock = threading.RLock()
        _, _, self.id, self.name = identity()
        self.found = {}
        self.lines = {}        # peer id -> open Line
        self.shows = {}        # peer id -> theme name the phone shows
        self.denied = {}       # peer id -> time the phone said it does not know us
        self.keepers = set()
        self.pairing = None
        self.answers = queue.Queue()
        self.status = ""
        self.last = None
        self.last_ts = 0
        self.scan_now = threading.Event()
        os.makedirs(STATE_DIR, exist_ok=True)
        self.ours_path = os.path.join(STATE_DIR, "ours.json")
        try:
            with open(self.ours_path) as f:
                self.ours = json.load(f)
        except (OSError, ValueError):
            self.ours = {}

    # Reporting

    def emit(self, o):
        with self.lock:
            try:
                self.out.write(json.dumps(o) + "\n")
                self.out.flush()
            except (OSError, ValueError):
                os._exit(0)

    def report(self, force=False):
        with self.lock:
            peers = load("peers.json", {})
            st = {
                "type": "state", "name": self.name, "theme": current_theme(), "avahi": bool(shutil.which("avahi-browse")),
                "peers": [{"id": pid, "name": p.get("name", "phone"), "app": p.get("app", ""), "connected": pid in self.lines,
                           "shows": self.shows.get(pid, ""), "forgot": pid in self.denied} for pid, p in peers.items()],
                "found": [f for fid, f in self.found.items() if fid not in peers],
                "pairing": self.pairing, "status": self.status,
            }
            if force or st != self.last:
                self.last = st
                self.emit(st)

    def say(self, text):
        self.status = text
        self.report()

    # Lines to the phones

    def signed(self, key, kind, body=""):
        with self.lock:
            ts = max(int(time.time() * 1000), self.last_ts + 1)
            self.last_ts = ts
        mac = hmac.new(key, f"{kind}.{ts}.{body}".encode(), hashlib.sha256).hexdigest()
        return {"t": kind, "id": self.id, "ts": ts, "body": body, "mac": mac}

    def keep_all(self):
        for pid in load("peers.json", {}):
            with self.lock:
                if pid in self.keepers:
                    continue
                self.keepers.add(pid)
            threading.Thread(target=self.keep, args=(pid,), daemon=True).start()

    def keep(self, pid):
        """One paired phone: connect, subscribe, take its themes, until it is forgotten."""
        while True:
            p = load("peers.json", {}).get(pid)
            if not p:
                break
            f = self.found.get(pid)
            addr = f"{f['host']}:{f['port']}" if f else p.get("addr", "")
            if not addr or time.time() - self.denied.get(pid, 0) < 60:
                self.scan_now.set()
                time.sleep(10)
                continue
            host, _, port = addr.rpartition(":")
            key = bytes.fromhex(p["key"])
            ln = None
            try:
                ln = Line(host, int(port), timeout=10)
                ln.send(self.signed(key, "sub"))
                if ln.recv().get("t") != "done":
                    self.denied[pid] = time.time()
                    self.report()
                    continue
                self.denied.pop(pid, None)
                ln.s.settimeout(None)
                if p.get("addr") != addr:
                    peers = load("peers.json", {})
                    if pid in peers:
                        peers[pid]["addr"] = addr
                        save("peers.json", peers)
                with self.lock:
                    self.lines[pid] = ln
                self.report()
                got = [False]

                def fallback():
                    # The phone sends what it shows right away; an older launcher does not, so send ours.
                    if not got[0]:
                        self.send(pid)
                threading.Timer(3, fallback).start()
                while True:
                    m = ln.recv()
                    if m.get("t") == "theme" and m.get("id") == pid and verified(key, m):
                        got[0] = True
                        self.from_phone(pid, p, json.loads(m.get("body") or "{}"))
            except (OSError, ValueError, ConnectionError):
                pass
            finally:
                if ln:
                    ln.close()
                with self.lock:
                    if self.lines.get(pid) is ln:
                        del self.lines[pid]
                self.report()
            self.scan_now.set()
            time.sleep(5)
        with self.lock:
            self.keepers.discard(pid)

    def send(self, pid, t=None):
        t = t or self.omarchy()
        p = load("peers.json", {}).get(pid)
        ln = self.lines.get(pid)
        if not (t and p and ln):
            return False
        try:
            ln.send(self.signed(bytes.fromhex(p["key"]), "theme", json.dumps(t)))
        except OSError:
            return False
        self.shows[pid] = t["theme"]
        self.emit({"type": "synced", "direction": "out", "device": p.get("name", "phone"), "theme": current_theme(), "at": int(time.time() * 1000)})
        self.report()
        return True

    # Sync

    def desktop_changed(self):
        """When a person last picked the Omarchy theme; a switch we made for a phone carries the phone's time."""
        if self.ours.get("name") and self.ours["name"] == current_theme():
            return int(self.ours.get("changed", 0))
        return theme_changed_ms()

    def omarchy(self):
        t = omarchy_theme()
        if t:
            t["changed"] = self.desktop_changed()
        return t

    def save_ours(self, o):
        self.ours = o
        with open(self.ours_path, "w") as f:
            json.dump(o, f)

    def from_phone(self, pid, p, t):
        self.shows[pid] = str(t.get("theme", ""))
        changed = int(t.get("changed") or 0)
        mine = self.desktop_changed()
        if not t.get("echo") and changed > mine:
            name = theme_for_phone(t)
            if name:
                self.save_ours({"name": name, "changed": changed, "source": pid})
                subprocess.run(["omarchy-theme-set", name], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self.emit({"type": "synced", "direction": "in", "device": p.get("name", "phone"), "theme": t.get("theme"), "omarchy": name, "at": int(time.time() * 1000)})
                self.report()
                return
        # Not taken. The phone already shows ours, or ours came from it: nothing to send.
        if changed == mine and (t.get("echo") or self.ours.get("source") == pid):
            self.report()
            return
        self.send(pid)

    def desktop_switched(self):
        """The Omarchy theme changed: tell every phone, but not the one it came from."""
        name = current_theme()
        source = self.ours.get("source") if self.ours.get("name") == name else None
        if not source and self.ours:
            self.save_ours({})
        for pid in list(self.lines):
            if pid != source:
                self.send(pid)

    def push(self):
        if not self.lines:
            self.say("No phone connected")
        for pid in list(self.lines):
            self.send(pid)

    # Pairing

    def pair(self, host, port):
        ports = [port] if port else [PORTS["hyprtile"], PORTS["phosphor"]]

        def ask(name, app, code):
            while not self.answers.empty():
                self.answers.get_nowait()
            self.pairing = {"name": name, "app": app, "code": code}
            self.status = ""
            self.report()
            try:
                return self.answers.get(timeout=PAIR_TIMEOUT) == "yes"
            except queue.Empty:
                return False
            finally:
                self.pairing = None
                self.report()

        self.say("Asking the phone")
        last = "Could not reach the phone"
        for pt in ports:
            try:
                pid = pair(host, pt, ask)
            except (OSError, ConnectionError) as e:
                last = "Could not reach the phone. Is link on, on the same wifi?" if isinstance(e, (ConnectionRefusedError, socket.timeout)) else f"Pairing broke off ({e})"
                continue
            except ValueError as e:
                last = f"Pairing failed ({e})"
                break
            if pid:
                self.denied.pop(pid, None)
                self.say("Paired. The theme follows from now on.")
                self.keep_all()
            else:
                self.say("Not paired")
            return
        self.say(last)

    def forget(self, pid):
        peers = load("peers.json", {})
        peers.pop(pid, None)
        save("peers.json", peers)
        ln = self.lines.get(pid)
        if ln:
            ln.close()
        self.say("Forgotten. Forget this computer on the phone too.")

    # Loops

    def commands(self):
        for line in sys.stdin:
            a = line.split()
            if not a:
                continue
            c = a[0]
            if c == "answer" and len(a) == 2:
                self.answers.put(a[1])
            elif c == "pair" and len(a) >= 2:
                host, port = parse_addr(a[1:])
                threading.Thread(target=self.pair, args=(host, port), daemon=True).start()
            elif c == "forget" and len(a) == 2:
                self.forget(a[1])
            elif c == "push":
                self.push()
            elif c == "scan":
                self.scan_now.set()
            elif c == "clear":
                self.say("")
        # The shell went away.
        os._exit(0)

    def scanner(self):
        while True:
            found = scan()
            with self.lock:
                self.found = found
            self.report()
            # Look often while a paired phone is missing, else now and then.
            missing = any(pid not in self.lines for pid in load("peers.json", {}))
            self.scan_now.wait(15 if missing else 60)
            self.scan_now.clear()

    def run(self):
        threading.Thread(target=self.commands, daemon=True).start()
        threading.Thread(target=self.scanner, daemon=True).start()
        self.keep_all()
        self.report(force=True)
        mtime = theme_changed_ms()
        while True:
            time.sleep(1)
            m = theme_changed_ms()
            if m != mtime:
                mtime = m
                time.sleep(0.5)
                self.desktop_switched()
            self.report()


def parse_addr(a):
    """'192.168.1.20 47800', '192.168.1.20:47800' or '192.168.1.20' to (host, port or None)."""
    s = " ".join(a).replace(":", " ").split()
    host = s[0]
    port = int(s[1]) if len(s) > 1 and s[1].isdigit() else None
    return host, port


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "help"
    if cmd == "watch":
        try:
            Daemon().run()
        except KeyboardInterrupt:
            pass
    elif cmd == "pair" and len(a) >= 2:
        host, port = parse_addr(a[1:])

        def ask(name, app, code):
            print(f"Pairing with {name} ({app}).\nCode: {code[:3]} {code[3:]}\nTap pair on the phone if it shows the same code.")
            return input("Same code here? [y/N] ").strip().lower() in ("y", "yes")

        for pt in [port] if port else [PORTS["hyprtile"], PORTS["phosphor"]]:
            try:
                pid = pair(host, pt, ask)
            except ConnectionRefusedError:
                continue
            print("Paired." if pid else "Not paired.")
            return
        sys.exit(f"Nothing listens on {host}. Turn link on in the launcher, on the same wifi.")
    elif cmd == "peers":
        print(json.dumps([{"id": k, "name": v.get("name"), "app": v.get("app"), "addr": v.get("addr")} for k, v in load("peers.json", {}).items()], indent=2))
    else:
        print(__doc__.strip())
        sys.exit(0 if cmd in ("help", "-h", "--help") else 2)


if __name__ == "__main__":
    main()
